{
	"controller_type": "oculus_touch",
	"name": "Cloudpunk VR raw controls",
	"description": "Every control passed through as itself; the layout is set in Cloudpunk VR 按键设置.exe.",
	"bindings": {
		"/actions/cloudpunk": {
			"sources": [
				{
					"path": "/user/hand/left/input/joystick",
					"mode": "joystick",
					"inputs": {
						"position": {
							"output": "/actions/cloudpunk/in/left_stick"
						},
						"click": {
							"output": "/actions/cloudpunk/in/left_stick_click"
						}
					}
				},
				{
					"path": "/user/hand/right/input/joystick",
					"mode": "joystick",
					"inputs": {
						"position": {
							"output": "/actions/cloudpunk/in/right_stick"
						},
						"click": {
							"output": "/actions/cloudpunk/in/right_stick_click"
						}
					}
				},
				{
					"path": "/user/hand/left/input/trigger",
					"mode": "trigger",
					"inputs": {
						"pull": {
							"output": "/actions/cloudpunk/in/left_trigger"
						}
					}
				},
				{
					"path": "/user/hand/right/input/trigger",
					"mode": "trigger",
					"inputs": {
						"pull": {
							"output": "/actions/cloudpunk/in/right_trigger"
						}
					}
				},
				{
					"path": "/user/hand/left/input/grip",
					"mode": "trigger",
					"inputs": {
						"pull": {
							"output": "/actions/cloudpunk/in/left_grip"
						}
					}
				},
				{
					"path": "/user/hand/right/input/grip",
					"mode": "trigger",
					"inputs": {
						"pull": {
							"output": "/actions/cloudpunk/in/right_grip"
						}
					}
				},
				{
					"path": "/user/hand/right/input/a",
					"mode": "button",
					"inputs": {
						"click": {
							"output": "/actions/cloudpunk/in/a"
						}
					}
				},
				{
					"path": "/user/hand/right/input/b",
					"mode": "button",
					"inputs": {
						"click": {
							"output": "/actions/cloudpunk/in/b"
						}
					}
				},
				{
					"path": "/user/hand/left/input/x",
					"mode": "button",
					"inputs": {
						"click": {
							"output": "/actions/cloudpunk/in/x"
						}
					}
				},
				{
					"path": "/user/hand/left/input/y",
					"mode": "button",
					"inputs": {
						"click": {
							"output": "/actions/cloudpunk/in/y"
						}
					}
				},
				{
					"path": "/user/hand/left/input/system",
					"mode": "button",
					"inputs": {
						"click": {
							"output": "/actions/cloudpunk/in/left_menu"
						}
					}
				}
			],
			"haptics": [
				{
					"output": "/actions/cloudpunk/out/haptic",
					"path": "/user/hand/left/output/haptic"
				},
				{
					"output": "/actions/cloudpunk/out/haptic",
					"path": "/user/hand/right/output/haptic"
				}
			]
		}
	}
}